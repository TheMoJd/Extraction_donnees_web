CHECKIT_LECTEUR_PASSWORD=change_moi

# --- Airflow ---
# Générer chaque clé avec :
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change_moi
AIRFLOW_JWT_SECRET=change_moi
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_moi
AIRFLOW_UID=50000
