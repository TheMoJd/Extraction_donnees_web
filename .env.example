# Copie ce fichier en ".env" et renseigne les vraies valeurs. Ne jamais commiter .env.

# --- Extraction ---
NEWSAPI_KEY=colle_ta_cle_newsapi_ici

# --- PostgreSQL (docker-compose) ---
POSTGRES_SUPERUSER_PASSWORD=change_moi
AIRFLOW_DB_PASSWORD=change_moi
